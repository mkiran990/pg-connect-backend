{
  "name": "pg-connect-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npx tsc && vite build",
    "lint": "npx tsc --noEmit",
    "preview": "vite preview",
    "worker:dev": "wrangler dev backend/src/index.ts",
    "worker:deploy": "wrangler deploy backend/src/index.ts",
    "d1:create": "wrangler d1 create pg-connect-db",
    "d1:migrate": "wrangler d1 execute pg-connect-db --local --file=schema.sql",
    "d1:migrate:prod": "wrangler d1 execute pg-connect-db --remote --file=schema.sql"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@cloudflare/workers-types": "^4.20240320.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "wrangler": "^3.36.0"
  }
}
